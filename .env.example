# Trakt API - obtener en https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=TU_CLIENT_ID
TRAKT_CLIENT_SECRET=TU_CLIENT_SECRET
TRAKT_ACCESS_TOKEN=TU_ACCESS_TOKEN
TRAKT_REFRESH_TOKEN=TU_REFRESH_TOKEN

# Gemini API - obtener en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=TU_GEMINI_API_KEY

# TMDB API - obtener en https://www.themoviedb.org/settings/api
TMDB_API_KEY=TU_TMDB_API_KEY

# Puerto del servidor (default: 7000)
PORT=7000
